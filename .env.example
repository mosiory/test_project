# ---------- Runtime ----------
NODE_ENV=production
# آدرس اتصال: پیش‌فرض فقط لوکال (پشت Nginx). برای دسترسی مستقیم: 0.0.0.0
HOST=127.0.0.1
PORT=4780

# اگر پشت Nginx/TLS هستید 1 کنید (برای تشخیص HTTPS و IP واقعی کاربر)
TRUST_PROXY=1
# اجبار HTTPS با ریدایرکت (فقط وقتی TLS terminate شده باشد)
FORCE_HTTPS=0

# ---------- Session ----------
# حداقل ۶۴ کاراکتر تصادفی: openssl rand -hex 32
# اگر خالی باشد، کلید در فایل data/.session-secret ذخیره می‌شود.
SESSION_SECRET=
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=12

# ---------- Login protection ----------
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_MAX_ATTEMPTS_PER_USER=8
LOGIN_WINDOW_MINUTES=10
LOGIN_BLOCK_MINUTES=15

# ---------- Backups ----------
# 0 = غیرفعال کردن پشتیبان‌گیری خودکار
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# ---------- Time ----------
# اختلاف منطقه زمانی محلی با UTC (تهران = 210 دقیقه)
APP_TZ_OFFSET_MINUTES=210

# ---------- فقط برای اولین ساخت دیتابیس ----------
# پس از اولین اجرا تغییری نمی‌دهند؛ رمزها را از داخل سامانه تغییر دهید.
INITIAL_ADMIN_PASSWORD=
INITIAL_SUP1_PASSWORD=
INITIAL_SUP2_PASSWORD=
